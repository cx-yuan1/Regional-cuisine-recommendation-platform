# 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# 数据库配置
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/food_recommend?charset=utf8mb4

# 密钥配置
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Flask环境
FLASK_ENV=development
FLASK_DEBUG=1

# DeepSeek AI（美食推荐对话）
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=XXX
